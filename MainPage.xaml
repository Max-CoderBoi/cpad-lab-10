<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WidgetDemoApp.MainPage"
             Title="Student Hub"
             BackgroundColor="#F5F7FB">

    <ScrollView x:Name="DashboardScrollView">
        <VerticalStackLayout Padding="22,18,22,32" Spacing="22">

            <Grid ColumnDefinitions="*,52"
                  ColumnSpacing="10">
                <HorizontalStackLayout Spacing="12"
                                       VerticalOptions="Center">
                    <VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="STUDENT HUB"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.4"
                               TextColor="#74809A"/>
                        <Label x:Name="GreetingLabel"
                               Text="Hello, Akash!"
                               FontSize="27"
                               FontAttributes="Bold"
                               TextColor="#17233B"/>
                        <Label x:Name="DateLabel"
                               FontSize="13"
                               TextColor="#7B879D"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <AbsoluteLayout Grid.Column="1"
                                WidthRequest="52"
                                HeightRequest="52"
                                VerticalOptions="Center">
                    <ImageButton Source="notification_bell.svg"
                                 WidthRequest="50"
                                 HeightRequest="50"
                                 Padding="14"
                                 BackgroundColor="White"
                                 CornerRadius="16"
                                 AbsoluteLayout.LayoutBounds="0,0,50,50"
                                 AbsoluteLayout.LayoutFlags="None"
                                 Clicked="OnNotificationsClicked"
                                 SemanticProperties.Description="Notifications"/>
                    <Border WidthRequest="12"
                            HeightRequest="12"
                            BackgroundColor="#F05B66"
                            Stroke="White"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"
                            AbsoluteLayout.LayoutBounds="38,1,12,12"
                            AbsoluteLayout.LayoutFlags="None"/>
                </AbsoluteLayout>
            </Grid>

            <Border x:Name="ProfileDetails"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="17">
                    <Grid ColumnDefinitions="78,*"
                          ColumnSpacing="14">
                        <Image Source="profile_avatar.svg"
                               WidthRequest="78"
                               HeightRequest="78"
                               Aspect="AspectFill"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="YOUR PROFILE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="#71809A"/>
                            <Label Text="Akash Patil"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#17233B"/>
                            <Label Text="Computer Engineering Student"
                                   FontSize="12"
                                   TextColor="#74809A"/>
                            <Label Text="Building a little every day"
                                   FontSize="12"
                                   TextColor="#4169C8"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="4"
                          Padding="0,3">
                        <VerticalStackLayout Spacing="3"
                                             HorizontalOptions="Center">
                            <Label Text="24"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#17233B"/>
                            <Label Text="POSTS"
                                   FontSize="10"
                                   CharacterSpacing="0.8"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#8792A7"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             HorizontalOptions="Center">
                            <Label Text="1.2k"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#17233B"/>
                            <Label Text="FOLLOWERS"
                                   FontSize="10"
                                   CharacterSpacing="0.8"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#8792A7"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"
                                             Spacing="3"
                                             HorizontalOptions="Center">
                            <Label Text="368"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#17233B"/>
                            <Label Text="FOLLOWING"
                                   FontSize="10"
                                   CharacterSpacing="0.8"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#8792A7"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button x:Name="LikeButton"
                                Text="Like (0)"
                                Clicked="OnLikeClicked"
                                BackgroundColor="#4268C9"
                                TextColor="White"
                                CornerRadius="13"
                                FontAttributes="Bold"/>
                        <Button Grid.Column="1"
                                Text="Message"
                                Clicked="OnMessageClicked"
                                BackgroundColor="#EEF2FC"
                                TextColor="#365BB7"
                                CornerRadius="13"
                                FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Your study snapshot"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#17233B"/>
                        <Label Text="Small steps add up."
                               FontSize="13"
                               TextColor="#7B879D"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="THIS WEEK"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           TextColor="#71809A"
                           VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <Border BackgroundColor="#E8F0FF"
                            Padding="13"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TOTAL"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#4971C8"/>
                            <Label x:Name="TotalTasksLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#3159B2"/>
                            <Label Text="tasks"
                                   FontSize="12"
                                   TextColor="#5270B4"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#E7F7EF"
                            Padding="13"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="DONE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#27835A"/>
                            <Label x:Name="CompletedTasksLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#20744D"/>
                            <Label Text="tasks"
                                   FontSize="12"
                                   TextColor="#408465"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            BackgroundColor="#FFF3E3"
                            Padding="13"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TO DO"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#B97728"/>
                            <Label x:Name="PendingTasksLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#A9681F"/>
                            <Label Text="tasks"
                                   FontSize="12"
                                   TextColor="#A97439"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Padding="17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="13">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="A note from you"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#17233B"/>
                            <Label Text="Share a thought or encouragement."
                                   FontSize="12"
                                   TextColor="#7B879D"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="CONNECT"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="#71809A"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry x:Name="CommentEntry"
                               Placeholder="Write your comment..."
                               BackgroundColor="#F3F5FA"
                               TextColor="#17233B"
                               PlaceholderColor="#94A0B4"
                               ClearButtonVisibility="WhileEditing"
                               Completed="OnCommentCompleted"/>
                        <Button Grid.Column="1"
                                Text="Post"
                                Clicked="OnCommentClicked"
                                BackgroundColor="#4268C9"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"/>
                    </Grid>
                    <Label x:Name="CommentLabel"
                           Text="No comments yet."
                           FontSize="12"
                           TextColor="#71809A"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="#EEF1F6"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="Notifications"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#24314A"/>
                            <Label x:Name="StatusLabel"
                                   Text="Notifications are enabled."
                                   FontSize="12"
                                   TextColor="#27835A"/>
                        </VerticalStackLayout>
                        <Switch x:Name="NotificationSwitch"
                                Grid.Column="1"
                                IsToggled="True"
                                Toggled="OnSwitchToggled"
                                VerticalOptions="Center"
                                OnColor="#4268C9"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Skills I'm growing"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#17233B"/>
                            <Label Text="A few things in my toolkit."
                                   FontSize="12"
                                   TextColor="#7B879D"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="SKILLS"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="#71809A"
                               VerticalOptions="Center"/>
                    </Grid>

                    <FlexLayout BindableLayout.ItemsSource="{Binding Skills}"
                                Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#EDF2FF"
                                        Padding="13,8"
                                        Margin="0,0,8,8"
                                        StrokeThickness="0"
                                        HorizontalOptions="Start"
                                        StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding .}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4264B5"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="My tasks"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#17233B"/>
                            <Label Text="Keep your next steps in sight."
                                   FontSize="12"
                                   TextColor="#7B879D"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="PLANNER"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="#71809A"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry x:Name="TaskEntry"
                               Placeholder="Add a task to your list"
                               BackgroundColor="#F3F5FA"
                               TextColor="#17233B"
                               PlaceholderColor="#94A0B4"
                               ReturnType="Done"
                               Completed="OnAddTaskClicked"/>
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddTaskClicked"
                                BackgroundColor="#4268C9"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"/>
                    </Grid>

                    <SearchBar x:Name="TaskSearchBar"
                               Placeholder="Search tasks"
                               TextChanged="OnTaskSearchTextChanged"
                               BackgroundColor="#F3F5FA"
                               TextColor="#17233B"
                               PlaceholderColor="#94A0B4"/>

                    <CollectionView ItemsSource="{Binding VisibleTasks}"
                                    SelectionMode="None"
                                    HeightRequest="220">
                        <CollectionView.EmptyView>
                            <Label Text="No matching tasks."
                                   TextColor="#71809A"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="15"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="4,7"
                                      ColumnSpacing="8">
                                    <CheckBox IsChecked="{Binding IsCompleted}"
                                              CheckedChanged="OnTaskCheckedChanged"
                                              VerticalOptions="Center"
                                              Color="#4268C9"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="13"
                                               TextColor="#24314A"/>
                                        <Label Text="{Binding StatusText}"
                                               FontSize="11"
                                               TextColor="#8591A6"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="Remove"
                                            FontSize="11"
                                            Padding="9,5"
                                            BackgroundColor="#FFF0EF"
                                            TextColor="#C14C4B"
                                            CornerRadius="9"
                                            Clicked="OnDeleteTaskClicked"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="13">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Attendance"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#17233B"/>
                        <Label Text="Keep showing up for your goals."
                               FontSize="12"
                               TextColor="#7B879D"/>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Text="Mark present"
                                Clicked="OnPresentClicked"
                                BackgroundColor="#27835A"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"/>
                        <Button Grid.Column="1"
                                Text="Mark absent"
                                Clicked="OnAbsentClicked"
                                BackgroundColor="#FFF0EF"
                                TextColor="#C14C4B"
                                CornerRadius="12"
                                FontAttributes="Bold"/>
                    </Grid>
                    <Label x:Name="AttendanceLabel"
                           Text="Present: 0 | Absent: 0"
                           FontSize="13"
                           TextColor="#35425A"/>
                    <ProgressBar x:Name="AttendanceProgress"
                                 Progress="0"
                                 ProgressColor="#27835A"
                                 BackgroundColor="#E8ECF2"/>
                    <Label x:Name="AttendancePercentageLabel"
                           Text="Attendance: 0%"
                           FontSize="12"
                           TextColor="#7B879D"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Padding="17"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Quick notes"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#17233B"/>
                        <Label Text="Save a thought for later."
                               FontSize="12"
                               TextColor="#7B879D"/>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry x:Name="NoteEntry"
                               Placeholder="Write a note..."
                               BackgroundColor="#F3F5FA"
                               TextColor="#17233B"
                               PlaceholderColor="#94A0B4"
                               ReturnType="Done"
                               Completed="OnAddNoteClicked"/>
                        <Button Grid.Column="1"
                                Text="Save"
                                Clicked="OnAddNoteClicked"
                                BackgroundColor="#4268C9"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"/>
                    </Grid>
                    <CollectionView ItemsSource="{Binding Notes}"
                                    SelectionMode="None"
                                    HeightRequest="150">
                        <CollectionView.EmptyView>
                            <Label Text="No notes saved yet."
                                   TextColor="#71809A"
                                   HorizontalOptions="Center"
                                   Padding="12"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="6">
                                    <Label Text="{Binding Text}"
                                           FontSize="13"
                                           TextColor="#35425A"
                                           VerticalOptions="Center"/>
                                    <Button Grid.Column="1"
                                            Text="Remove"
                                            FontSize="11"
                                            Padding="9,5"
                                            BackgroundColor="#FFF0EF"
                                            TextColor="#C14C4B"
                                            CornerRadius="9"
                                            Clicked="OnDeleteNoteClicked"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="View full profile"
                    Clicked="OnViewProfileClicked"
                    BackgroundColor="#4268C9"
                    TextColor="White"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    HeightRequest="52"/>

            <Label Text="STUDENT HUB  ·  MADE FOR YOUR NEXT STEP"
                   FontSize="10"
                   CharacterSpacing="1"
                   TextColor="#9AA4B6"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
