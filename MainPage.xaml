<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WidgetDemoApp.MainPage"
             Title="Student Hub"
             BackgroundColor="#F3F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label x:Name="GreetingLabel"
                       Text="Hello, Student!"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#172033"/>

                <Label x:Name="DateLabel"
                       FontSize="13"
                       TextColor="#7B8495"/>
            </VerticalStackLayout>

            <!-- Student Profile -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="STUDENT PROFILE"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#64748B"/>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="65"
                                HeightRequest="65"
                                BackgroundColor="#DBEAFE"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 35"
                                VerticalOptions="Center">

                            <Label Text="AP"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="4">

                            <Label Text="Akash Patil"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#172033"/>

                            <Label Text="Computer Engineering Student"
                                   FontSize="13"
                                   TextColor="#64748B"/>

                            <Label Text="Interested in Software Development"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Button x:Name="LikeButton"
                                Text="♥ Like (0)"
                                Clicked="OnLikeClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="10"/>

                        <Button Grid.Column="1"
                                Text="Message"
                                Clicked="OnMessageClicked"
                                BackgroundColor="#E8EEF9"
                                TextColor="#2563EB"
                                CornerRadius="10"/>
                    </Grid>

                    <Label Text="Leave a comment"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#172033"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <Entry x:Name="CommentEntry"
                               Placeholder="Write your comment..."
                               BackgroundColor="#F3F5F9"
                               TextColor="#172033"
                               PlaceholderColor="#94A3B8"
                               Completed="OnCommentCompleted"/>

                        <Button Grid.Column="1"
                                Text="Post"
                                Clicked="OnCommentClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="10"/>
                    </Grid>

                    <Label x:Name="CommentLabel"
                           Text="No comments yet."
                           FontSize="13"
                           TextColor="#64748B"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Enable notifications"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="#172033"/>

                        <Switch x:Name="NotificationSwitch"
                                Grid.Column="1"
                                IsToggled="True"
                                Toggled="OnSwitchToggled"/>
                    </Grid>

                    <Label x:Name="StatusLabel"
                           Text="Notifications are enabled."
                           FontSize="12"
                           TextColor="#16A34A"/>
                </VerticalStackLayout>
            </Border>

            <!-- Dashboard Statistics -->
            <Label Text="My Dashboard"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="#172033"/>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10">

                <Border BackgroundColor="#DBEAFE"
                        Padding="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="TOTAL"
                               FontSize="11"
                               TextColor="#1D4ED8"/>

                        <Label x:Name="TotalTasksLabel"
                               Text="0"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#1D4ED8"/>

                        <Label Text="Tasks"
                               FontSize="12"
                               TextColor="#1D4ED8"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#DCFCE7"
                        Padding="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="DONE"
                               FontSize="11"
                               TextColor="#15803D"/>

                        <Label x:Name="CompletedTasksLabel"
                               Text="0"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#15803D"/>

                        <Label Text="Tasks"
                               FontSize="12"
                               TextColor="#15803D"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#FEF3C7"
                        Padding="12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="PENDING"
                               FontSize="11"
                               TextColor="#B45309"/>

                        <Label x:Name="PendingTasksLabel"
                               Text="0"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#B45309"/>

                        <Label Text="Tasks"
                               FontSize="12"
                               TextColor="#B45309"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Task Management -->
            <Border BackgroundColor="White"
                    Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Task Management"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#172033"/>

                    <Entry x:Name="TaskEntry"
                           Placeholder="Enter a new task"
                           BackgroundColor="#F3F5F9"
                           TextColor="#172033"
                           PlaceholderColor="#94A3B8"/>

                    <Button Text="+ Add Task"
                            Clicked="OnAddTaskClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="10"/>

                    <SearchBar x:Name="TaskSearchBar"
                               Placeholder="Search tasks"
                               TextChanged="OnTaskSearchTextChanged"
                               BackgroundColor="#F3F5F9"
                               TextColor="#172033"
                               PlaceholderColor="#94A3B8"/>

                    <CollectionView ItemsSource="{Binding VisibleTasks}"
                                    SelectionMode="None"
                                    HeightRequest="240">

                        <CollectionView.EmptyView>
                            <Label Text="No tasks found."
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="15"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="5"
                                      ColumnSpacing="8">

                                    <CheckBox IsChecked="{Binding IsCompleted}"
                                              CheckedChanged="OnTaskCheckedChanged"
                                              VerticalOptions="Center"
                                              Color="#2563EB"/>

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">

                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               TextColor="#172033"/>

                                        <Label Text="{Binding StatusText}"
                                               FontSize="11"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            FontSize="11"
                                            Padding="8,4"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#B91C1C"
                                            CornerRadius="8"
                                            Clicked="OnDeleteTaskClicked"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <!-- Attendance -->
            <Border BackgroundColor="White"
                    Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Attendance Tracker"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#172033"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Button Text="Mark Present"
                                Clicked="OnPresentClicked"
                                BackgroundColor="#16A34A"
                                TextColor="White"
                                CornerRadius="10"/>

                        <Button Grid.Column="1"
                                Text="Mark Absent"
                                Clicked="OnAbsentClicked"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                CornerRadius="10"/>
                    </Grid>

                    <Label x:Name="AttendanceLabel"
                           Text="Present: 0 | Absent: 0"
                           FontSize="14"
                           TextColor="#172033"/>

                    <ProgressBar x:Name="AttendanceProgress"
                                 Progress="0"
                                 ProgressColor="#16A34A"
                                 BackgroundColor="#E2E8F0"/>

                    <Label x:Name="AttendancePercentageLabel"
                           Text="Attendance: 0%"
                           FontSize="13"
                           TextColor="#64748B"/>
                </VerticalStackLayout>
            </Border>

            <!-- Skills -->
            <Border BackgroundColor="White"
                    Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Technical Skills"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#172033"/>

                    <CollectionView ItemsSource="{Binding Skills}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="48"
                                    SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#DBEAFE"
                                        Padding="12,8"
                                        Margin="3"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">

                                    <Label Text="{Binding .}"
                                           FontSize="13"
                                           TextColor="#1D4ED8"
                                           VerticalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <Border BackgroundColor="White"
                    Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Quick Notes"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#172033"/>

                    <Entry x:Name="NoteEntry"
                           Placeholder="Write a note..."
                           BackgroundColor="#F3F5F9"
                           TextColor="#172033"
                           PlaceholderColor="#94A3B8"/>

                    <Button Text="+ Add Note"
                            Clicked="OnAddNoteClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="10"/>

                    <CollectionView ItemsSource="{Binding Notes}"
                                    SelectionMode="None"
                                    HeightRequest="150">

                        <CollectionView.EmptyView>
                            <Label Text="No notes added yet."
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   Padding="12"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="6">

                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           TextColor="#172033"
                                           VerticalOptions="Center"/>

                                    <Button Grid.Column="1"
                                            Text="Remove"
                                            FontSize="11"
                                            Padding="8,4"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#B91C1C"
                                            CornerRadius="8"
                                            Clicked="OnDeleteNoteClicked"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Label Text="Student Hub • Built with .NET MAUI"
                   FontSize="12"
                   TextColor="#94A3B8"
                   HorizontalOptions="Center"
                   Margin="0,5,0,15"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>